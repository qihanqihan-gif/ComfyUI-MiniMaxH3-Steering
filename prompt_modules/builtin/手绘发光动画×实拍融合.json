  "evidence_level": "official_skill_adaptation",
  "features": ["handdrawn_live_fusion", "physical_contact", "continuous_morph", "delayed_handheld_follow"],
  "conflicts": [],
  "semantic_contract": {
    "purpose": "让同一个粗糙手绘发光实体在连续实拍空间中与真实表面接触、变形并移动。",
    "adds": [
      {"path": "scene.recipe.primary", "value": "handdrawn_live_contact_chase"},
      {"path": "visual.medium.primary", "value": "rough_handdrawn_animation_over_live_action"},
      {"path": "interaction.physical_contact", "value": "early_clear_contact_with_real_surface_or_hand"}
    ],
    "preserves": [
      "scene.live_action_materials",
      "subject.single_entity_continuity",
      "subject.color_and_stroke_motif",
      "timeline.continuity",
      "camera.motion.primary"
    ],
    "forbids": [
      "smooth_cg_vector_or_plush_rendering",
      "unmotivated_new_entity_after_morph",
      "contact_without_occlusion_or_surface_response",
      "unrequested_horror_monster_or_jump_scare",
      "unmotivated_location_cut"
    ],
    "defaults": [
      {"path": "camera.motion.primary", "value": "slightly_delayed_handheld_follow_when_unspecified"},
      {"path": "tone", "value": "playful_gentle_and_surreal"}
    ]
  },
  "ownership": {
    "reads": ["scene.live_action_space", "user.tone", "camera.motion.primary"],
    "writes": ["scene.recipe.primary", "visual.medium.primary"],
    "augments": ["interaction.physical_contact", "subject.morph_continuity", "audio.contact_sfx"]
  },
  "resolution": {
    "exclusive_group": ["scene.recipe.primary", "visual.medium.primary"],
    "priority": 60,
    "requires": [],
    "conflicts": []
  },
  "instructions": "手绘发光动画×实拍融合配方：同一个手绘实体在一个实拍空间或相邻区域内连续发生接触、变形和移动。\n1. 手绘质感采用蜡笔、粉笔、彩铅、粉彩或粗糙笔刷，保留轻微抖线、毛边、涂抹不均和逐帧重画感；真实表面的材质、光线和空间关系保持可信。\n2. 开段尽早让实体与真实手或物体明确接触，并呈现遮挡、承托、缠绕、按压或反作用；之后每次变形都保留前一形态的线条、色彩拖痕或图案母题，不能突然换成新角色。\n3. 用出现 → 接触 → 连续变形/移动 → 空间回应完成一个节拍。若无其它主运镜规则，采用略慢半拍的手持追随；已有主运镜时保持事件可读。\n4. 避免光滑 CG、均匀矢量霓虹、毛绒玩具、无接触漂浮、无动机换地点，以及用户未要求的怪物、威吓或跳吓。"
}
