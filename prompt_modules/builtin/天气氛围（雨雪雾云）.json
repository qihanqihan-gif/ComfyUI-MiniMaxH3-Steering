{
  "id": "weather_ambience",
  "title_zh": "天气氛围（雨雪雾云）",
  "version": 3,
  "scope": "全部",
  "category": "environment",
  "source": "MiniMax-H3 official ambience examples + community animation heuristics",
  "source_url": "https://github.com/MiniMax-AI/MiniMax-H3/tree/main/skills/h3-prompt-writing",
  "evidence_level": "official_aligned",
  "features": ["weather", "environment_interaction", "soundscape"],
  "conflicts": [],
  "semantic_contract": {
    "purpose": "建立一种与用户意图或参考证据一致的主导天气，并补充环境、可见表面和声音的物理响应。",
    "adds": [
      {"path": "environment.weather.primary", "value": "user_or_evidence_aligned_weather"}
    ],
    "preserves": [
      "subject.identity",
      "subject.user_requested_action",
      "scene.structure",
      "camera.motion.primary",
      "timeline.layout.primary"
    ],
    "forbids": [
      "multiple_competing_weather_systems",
      "weather_intensity_without_environment_response",
      "unmotivated_weather_or_lighting_jump",
      "inaudible_weather_described_as_loud_sound"
    ],
    "defaults": [
      {"path": "environment.weather.count", "value": 1},
      {"path": "environment.weather.intensity", "value": "restrained"}
    ]
  },
  "ownership": {
    "reads": ["user.weather_intent", "media.visible_weather", "scene.materials", "timeline"],
    "writes": ["environment.weather.primary"],
    "augments": ["environment.surface_response", "environment.visibility", "visual.lighting.weather_response", "soundscape.environment"]
  },
  "resolution": {
    "exclusive_group": "environment.weather.primary",
    "priority": 40,
    "requires": [],
    "conflicts": []
  },
  "instructions": "天气氛围规则：围绕一种主导天气建立连续、可观察的环境变化，不重写主体身份、主要动作、主运镜或分镜结构。\n1. 优先采用用户明确指定或参考素材可见的天气；只写一种主导天气，并说明强度、方向与节奏。未指定具体类型时，选择与场景和情绪相容的克制方案，不叠加互相竞争的雨、雪、雾、雷暴。\n2. 描述天气与可见表面的接触和累积结果，例如雨滴、积水、湿润反光、积雪、雾中光散射或移动云影。\n3. 植被、衣料、水面和能见度只产生与天气强度相称的次级响应，不借天气替主体新增大幅动作，也不改变原场景结构。\n4. 只加入现实中可听见的声源，如雨、风、雷、湿地脚步或物体受风声；轻雪本身不夸张成清晰声效。除非用户要求天气转变，否则天气、地面状态和受天气影响的光线在时间线上保持连续。"
}
